# Every setting the programs read; each program's cmd/<name>/settings.go says which it reads. Copy
# to .env for local runs; servers set these in the environment.

# development (readable logs) or production (JSON logs). Default: production.
APP_ENV=development

# The API only. Default: :8080. Port 0 picks a free port and logs it.
HTTP_ADDR=:8080

# Required. Its port must match POSTGRES_PORT below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# Required: the job queue, a Valkey or Redis. The API queues jobs there and the worker runs them.
# Its port must match VALKEY_PORT below. Use rediss:// for a server that needs TLS.
REDIS_URL=redis://localhost:6379/0

# trace, debug, info, warn, error. Default: info.
LOG_LEVEL=debug

# Tests only: a local Postgres where tests create and drop their own databases (one per test).
# Point it at the server's "postgres" database; any host but localhost is refused. Same port as
# POSTGRES_PORT.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Tests only: where tests queue jobs. A local Valkey and a database other than 0 (the app's), so a
# worker running on your machine never picks up a test's job. Same port as VALKEY_PORT.
TEST_REDIS_URL=redis://localhost:6379/1

# Local only: the port `make db-up` (docker compose) gives Postgres. Compose reads this file too.
# Change it if another Postgres already uses 5432.
POSTGRES_PORT=5432

# Local only: the port `make db-up` gives Valkey. Change it if another Redis already uses 6379.
VALKEY_PORT=6379
