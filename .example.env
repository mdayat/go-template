# Every setting the programs read; each program's cmd/<name>/settings.go says which it reads. Copy
# to .env for local runs; servers set these in the environment.

# development (readable logs) or production (JSON logs). Default: production.
APP_ENV=development

# remove:api
# The API only. Default: :8080. Port 0 picks a free port and logs it.
HTTP_ADDR=:8080
# remove:end

# remove:api
# The API only, required: whose sign-in tokens to accept. AUTH_JWKS_URL is the provider's public
# keys (https:// in production, answering 200 itself: a redirect isn't followed; Firebase's is
# https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com).
# AUTH_ISSUER must equal a token's "iss", AUTH_AUDIENCE be in its "aud" (Firebase: the issuer
# https://securetoken.google.com/<project-id>, the audience <project-id>). For local runs, `make
# dev-token` signs tokens with a key it publishes at the file below.
AUTH_JWKS_URL=file://.dev/auth/keys.json
AUTH_ISSUER=https://dev.local
AUTH_AUDIENCE=go-template
# remove:end

# remove:api
# The API only: requests a minute per client IP without a valid sign-in, and per signed-in user;
# 0 = no limit. Defaults: 600 and 120. Counted in Valkey, so they hold across every copy of the API.
RATE_LIMIT_PER_IP=600
RATE_LIMIT_PER_USER=120
# The API only, behind a load balancer, CDN or other proxy: their IP ranges, comma-separated
# (10.0.0.0/8,2001:db8::/32). Requests from them have the client's IP read from X-Forwarded-For.
# Unset: the client is whoever opens the connection, which behind a proxy is the proxy, so every
# signed-out client would share one rate limit. Never a range clients can send from: they could pick their IP.
TRUSTED_PROXIES=
# remove:end

# Required. Its port must match POSTGRES_PORT below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# Postgres's own time limits on each connection, written 500ms, 10s, 5m: the longest one statement
# may run, and the longest a transaction may stay open with nothing running
# (docs/standards/database.md#time-limits). Not in DATABASE_URL: the programs refuse it there.
# Unset: each program's default.
# remove:api
# The API's: 10s and 10s.
# remove:end
# remove:worker
# The worker's: 5m and 1m.
# remove:end
DB_STATEMENT_TIMEOUT=
DB_IDLE_IN_TRANSACTION_TIMEOUT=

# remove:valkey
# Required: a Valkey (or Redis) every copy of the programs shares. Its port must match VALKEY_PORT
# below. Use rediss:// for a server that needs TLS.
REDIS_URL=redis://localhost:6379/0
# remove:end

# remove:worker
# The worker only, optional: a URL told (POST, JSON) each time deleted rows are purged. Unset: no report.
PURGE_WEBHOOK_URL=
# remove:end

# Metrics and traces, read by OpenTelemetry itself (docs/standards/metrics.md, tracing.md). Both are
# on unless set to none, pushed with OTLP: metrics every OTEL_METRIC_EXPORT_INTERVAL ms (default
# 60000), traces in batches every few seconds. OTEL_METRICS_EXPORTER=prometheus serves metrics for pulling instead.
# These point at the Prometheus (every 10 s) and Jaeger of `make telemetry-up`: their ports must
# match PROMETHEUS_PORT and JAEGER_OTLP_PORT below. With nothing listening, a warning is logged
# once a minute: start them, or set both exporters to none.
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:9090/api/v1/otlp/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRIC_EXPORT_INTERVAL=10000

# trace, debug, info, warn, error. Default: info.
LOG_LEVEL=debug

# Tests only: a local Postgres where tests create and drop their own databases (one per test).
# Point it at the server's "postgres" database; any host but localhost is refused. Same port as
# POSTGRES_PORT.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# remove:valkey
# Tests only: a local Valkey and a database other than 0 (the app's), so tests never touch the
# app's data. Same port as VALKEY_PORT.
TEST_REDIS_URL=redis://localhost:6379/1
# remove:end

# Local only: the port `make db-up` (docker compose) gives Postgres. Compose reads this file too.
# Change it if another Postgres already uses 5432.
POSTGRES_PORT=5432

# Local only: the ports `make telemetry-up` gives Prometheus, Grafana and Jaeger (its view, and
# where it receives traces), on this machine only.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686
JAEGER_OTLP_PORT=4318

# remove:valkey
# Local only: the port `make db-up` gives Valkey. Change it if another Redis already uses 6379.
VALKEY_PORT=6379
# remove:end
